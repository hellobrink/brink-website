---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/base';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

// Link each byline to the author's bio where they're one of ours.
const team = await getCollection('team');
const bio = (slug?: string) => (slug ? team.find((m) => m.id === slug) : undefined);
const authors = [
  { name: data.authorName, member: bio(data.authorSlug) },
  data.authorName2 ? { name: data.authorName2, member: bio(data.authorSlug2) } : null,
].filter(Boolean) as { name: string; member: any }[];

// Dates are stored ISO (YYYY-MM-DD); show them as "27 July 2026". Midday avoids
// any timezone day-shift.
const displayDate = data.date
  ? new Date(data.date + 'T12:00:00').toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : '';

// --- Post-footer actions (both on by default; toggled per-post in the CMS) ---
// Share opens LinkedIn's own share dialog pre-filled with this post's absolute
// URL. Astro.site is the deploy origin, so this follows the domain at cutover.
const shareUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const linkedInShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;

// Contact emails the first author. Use their explicit team email if set, else
// derive firstname@hellobrink.co from their name (Brink's convention).
const firstAuthor = authors[0];
const firstName = firstAuthor?.name?.trim().split(/\s+/)[0];
// First name -> email local part. NFD splits accented letters into base +
// combining mark (é -> e + ´); the a-z filter then drops the mark, so "José"
// becomes "jose".
const emailLocalPart = (name: string) =>
  name.trim().split(/\s+/)[0].toLowerCase().normalize('NFD').replace(/[^a-z]/g, '');
const authorEmail = firstAuthor?.member
  ? (firstAuthor.member.data.email ?? `${emailLocalPart(firstAuthor.member.data.name)}@hellobrink.co`)
  : undefined;
const mailto = authorEmail
  ? `mailto:${authorEmail}?subject=${encodeURIComponent('Re: ' + data.title)}`
  : undefined;

const showShare = data.shareLinkedIn;
const showContact = data.contactAuthor && !!authorEmail && !!firstName;
---

<Layout title={data.title} description={data.subheading ?? data.summary} ogImage={data.bannerImage ?? data.heroImage} ogType="article">
  <article class="post">
    <div class="container narrow">
      <p class="back"><a href={withBase('/blog')}>&larr; All posts</a></p>
      <h1>{data.title}</h1>
      <p class="byline mono">
        {authors.map((a, i) => (
          <>
            {i > 0 ? ' & ' : ''}
            {a.member ? (
              <a href={withBase(`/team/${a.member.id}`)}>{a.name}</a>
            ) : (
              a.name
            )}
          </>
        ))}
        {displayDate && authors.length > 0 ? ' · ' : ''}
        {displayDate}
      </p>
      {data.subheading && <p class="standfirst">{data.subheading}</p>}
    </div>

    {data.bannerImage && (
      <figure class="post-banner">
        <img src={withBase(data.bannerImage)} alt={data.bannerAlt ?? data.title} />
      </figure>
    )}

    <div class:list={[data.longform ? 'container lf-wide' : 'container narrow']}>
      <div class:list={['prose', { longform: data.longform }]}>
        <Content />
      </div>
    </div>

    {(showShare || showContact) && (
      <div class="container narrow">
        <footer class="post-actions">
          {showShare && (
            <a class="post-action" href={linkedInShare} target="_blank" rel="noopener noreferrer">
              <svg class="post-action-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
              </svg>
              <span>Share this post on LinkedIn</span>
            </a>
          )}
          {showContact && (
            <a class="post-action" href={mailto}>
              <svg class="post-action-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2.5" y="4.5" width="19" height="15" rx="2"/>
                <path d="m3 6 9 6.5L21 6"/>
              </svg>
              <span>Get in touch with {firstName}</span>
            </a>
          )}
        </footer>
      </div>
    )}
  </article>
</Layout>

<script>
  // Long-form magazine layout. Sections are delimited by headings; each
  // section's images pin to one side (alternating per section) as a stacked
  // "swap" figure while the heading + text scroll alongside. A section with
  // more than one image cross-fades between them as the reader scrolls to
  // where each image sits in the text. No-op without .prose.longform.
  for (const prose of document.querySelectorAll('.prose.longform')) {
    const isImg = (el: Element) =>
      el.tagName === 'P' && !!el.querySelector(':scope > img') && !el.textContent!.trim();

    // Per-image opt-out of the pinned side layout: an editor starts the image's
    // alt text with "banner:" to render it full-width in the flow instead. Mark
    // those paragraphs and strip the marker off the alt, so the real description
    // (and the accessibility text) is preserved and no "banner" tooltip shows.
    const BANNER = /^\s*banner:\s*/i;
    for (const p of prose.querySelectorAll('p')) {
      const img = p.querySelector(':scope > img');
      const alt = img?.getAttribute('alt') ?? '';
      if (img && !p.textContent!.trim() && BANNER.test(alt)) {
        img.setAttribute('alt', alt.replace(BANNER, '').trim());
        img.removeAttribute('title');
        p.classList.add('lf-banner');
      }
    }
    const isBanner = (el: Element) => el.classList.contains('lf-banner');
    // A pinnable image is an image paragraph the editor hasn't marked as a banner.
    const isPinImg = (el: Element) => isImg(el) && !isBanner(el);
    // Only the top two heading levels start a new pinned scene. H3–H6 are
    // sub-headings that live *inside* a scene's text column, so an editor can
    // break a long section into numbered points without fragmenting it into
    // lots of short scenes (a scene shorter than the viewport can't visibly
    // pin its image). One panel per H1/H2; everything under it scrolls as one.
    // Empty headings never count as a section break (the build strips them, but
    // guard here too so a stray blank heading can't hand a panel an empty title).
    const isHeading = (el: Element) => /^H[12]$/.test(el.tagName) && !!el.textContent!.trim();
    const allKids = [...prose.children];

    // A trailing coda: from the last top-level <hr> to the end, as long as no
    // image follows it. Rendered full-width in normal flow (a conclusion, a
    // footnotes block) rather than trapped in the final scene's half-width
    // text column. This is why a post ends its magazine flow with a `---`.
    let codaStart = -1;
    for (let i = allKids.length - 1; i >= 0; i--) {
      if (allKids[i].tagName === 'HR') { codaStart = i; break; }
    }
    if (codaStart >= 0 && allKids.slice(codaStart).some(isPinImg)) codaStart = -1;
    const kids = codaStart >= 0 ? allKids.slice(0, codaStart) : allKids;
    const codaKids = codaStart >= 0 ? allKids.slice(codaStart) : [];

    // Intro = everything before the first heading whose section holds a pinned
    // image. Banner-only sections aren't scenes, so they don't start the flow.
    const headings = kids.map((el, i) => (isHeading(el) ? i : -1)).filter((i) => i >= 0);
    let firstSection = -1;
    for (let h = 0; h < headings.length; h++) {
      const start = headings[h], end = headings[h + 1] ?? kids.length;
      if (kids.slice(start, end).some(isPinImg)) { firstSection = start; break; }
    }
    if (firstSection < 0) continue;

    const intro = document.createElement('div');
    intro.className = 'lf-intro';
    kids.slice(0, firstSection).forEach((k) => intro.appendChild(k));

    const scenes = document.createElement('div');
    scenes.className = 'lf-scenes';
    const swapSections: { steps: { el: Element; img: Element }[]; current: Element | null }[] = [];
    const starts = headings.filter((i) => i >= firstSection);

    // Alternation counts only the image sections, so an interleaved
    // full-width block doesn't flip the left/right rhythm of the scenes.
    let sceneIndex = 0;
    starts.forEach((start, s) => {
      const end = starts[s + 1] ?? kids.length;
      const chunk = kids.slice(start, end);

      // A section with no pinned image isn't a pinned scene — render it
      // full-width in normal flow. This covers a closing text section and a
      // section whose only image is a banner (which renders full-width inside).
      if (!chunk.some(isPinImg)) {
        const block = document.createElement('div');
        block.className = 'lf-block';
        chunk.forEach((k) => block.appendChild(k));
        scenes.appendChild(block);
        return;
      }

      const scene = document.createElement('div');
      scene.className = 'lf-scene ' + (sceneIndex % 2 ? 'media-right' : 'media-left');
      sceneIndex++;
      // Anything before the first image (the section heading and any intro
      // paragraphs) runs full-width above the two pinned columns. So a section
      // opens with its heading across the page and only starts pinning at its
      // first image - which is how you get a wide heading with the photos
      // beginning at the first point, no invisible-heading hack required.
      const lead = document.createElement('div');
      lead.className = 'lf-lead';
      const media = document.createElement('figure');
      media.className = 'lf-media';
      const text = document.createElement('div');
      text.className = 'lf-text';

      const imgs: Element[] = [];
      let pending: Element | null = null;
      let inLead = true;
      const steps: { el: Element; img: Element }[] = [];
      for (const k of chunk) {
        // The lead ends at the first image or the first sub-heading (a numbered
        // point), whichever comes first - so the wide section heading + intro
        // sit above, and the points with their photos begin the pinned columns.
        // This holds whether the editor puts a point's image before or after its
        // sub-heading.
        if (inLead && (isPinImg(k) || /^H[3-6]$/.test(k.tagName))) inLead = false;
        if (isPinImg(k)) {
          const img = k.querySelector('img')!;
          img.classList.add('lf-frame');
          media.appendChild(img);
          imgs.push(img);
          pending = img;
        } else if (isBanner(k)) {
          lead.appendChild(k); // full-width banner, hoisted above the pinned columns
        } else if (inLead) {
          lead.appendChild(k); // heading + intro, above the pinned columns
        } else if (k.classList.contains('post-caption')) {
          text.appendChild(k); // keep captions in the reading column
        } else {
          if (pending) { steps.push({ el: k, img: pending }); pending = null; }
          text.appendChild(k);
        }
      }
      if (imgs[0]) imgs[0].classList.add('active');
      if (lead.children.length) scene.appendChild(lead);
      scene.append(media, text);
      scenes.appendChild(scene);
      if (imgs.length > 1 && steps.length) swapSections.push({ steps, current: imgs[0] });
    });

    const coda = codaKids.length ? document.createElement('div') : null;
    if (coda) {
      coda.className = 'lf-coda';
      codaKids.forEach((k) => coda.appendChild(k));
    }

    prose.replaceChildren(intro, scenes, ...(coda ? [coda] : []));

    // Cross-fade the multi-image sections on scroll: the active frame is the
    // last step whose anchor has passed the middle of the viewport.
    if (swapSections.length) {
      const onScroll = () => {
        const mid = window.innerHeight / 2;
        for (const sec of swapSections) {
          let active = sec.steps[0].img;
          for (const step of sec.steps) if (step.el.getBoundingClientRect().top <= mid) active = step.img;
          if (sec.current !== active) {
            for (const step of sec.steps) step.img.classList.toggle('active', step.img === active);
            sec.current = active;
          }
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>

<style>
  .post {
    padding-top: var(--space-6);
    padding-bottom: var(--space-9);
  }

  .narrow {
    max-width: var(--measure);
  }

  .back a {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .post h1 {
    font-size: var(--text-display-lg);
    line-height: var(--leading-tight);
    margin: var(--space-4) 0 var(--space-4);
  }

  .byline {
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }
  .byline a { color: var(--color-text); text-decoration: none; }
  .byline a:hover { color: var(--color-accent-ink); }

  /* Standfirst: clearly below the H1, not competing with it. */
  .standfirst {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: var(--leading-snug, 1.35);
    color: var(--color-text-muted);
    margin: 0;
    max-width: var(--measure);
  }

  /* Post-footer actions: a share + a contact button, divided from the article
     by a quiet rule. Mono uppercase to match the site's button language. */
  .post-actions {
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .post-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-text);
    background: transparent;
    border: var(--border-width-button) solid var(--color-text);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-5);
    transition: background var(--transition), color var(--transition);
  }
  .post-action:hover {
    background: var(--color-text);
    color: var(--color-text-inverted);
  }
  .post-action-icon {
    width: 1.2em;
    height: 1.2em;
    flex: none;
  }
  @media (max-width: 480px) {
    .post-actions { flex-direction: column; }
    .post-action { justify-content: center; }
  }

  /* Full-bleed banner: the images are landscape, so let them run edge to edge
     regardless of the container padding. */
  .post-banner {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin: var(--space-7) -50vw;
  }
  .post-banner img {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: cover;
    display: block;
  }

  /* --- Article body ------------------------------------------------------- */
  .prose :global(img) {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: var(--space-5) 0;
    border-radius: var(--radius);
  }

  /* Heading hierarchy: H1 is the big title; in-article headings step down
     clearly from it. */
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--size-2xl);
    line-height: var(--leading-tight);
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .prose :global(h4) {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  /* Image captions: small, muted and centred, so they read as a caption
     rather than body copy. Pull the caption up tight under its image. */
  .prose :global(.post-caption) {
    margin: var(--space-2) 0 var(--space-6);
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    text-align: center;
  }
  .prose :global(p:has(> img):has(+ .post-caption)) {
    margin-bottom: 0;
  }

  /* Embedded video (a one-off on the founders' post): full width with native
     controls. */
  .prose :global(.post-video) {
    margin: var(--space-6) 0;
  }
  .prose :global(.post-video video) {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    display: block;
    border-radius: var(--radius);
    background: #000;
  }

  /* Pull quotes: set apart from the (serif, upright) section headings with an
     italic face inside a tinted panel and a coral rule. */
  .prose :global(blockquote) {
    margin: var(--space-7) 0;
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface-muted);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--weight-regular, 400);
    font-size: var(--size-2xl);
    line-height: var(--leading-snug, 1.3);
    color: var(--color-text);
  }
  .prose :global(blockquote p) {
    margin: 0 0 var(--space-3);
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  /* A long, multi-paragraph quotation (e.g. quoting a paper) is not a pull-out
     quote: render it smaller and without the panel, so it reads as a citation. */
  .prose :global(blockquote:has(p + p)) {
    background: none;
    border-radius: 0;
    padding: var(--space-1) 0 var(--space-1) var(--space-5);
    font-size: var(--text-lead);
    line-height: var(--leading-normal);
  }

  /* Horizontal rule: a quiet divider (used to end the magazine flow before a
     conclusion / footnotes coda). */
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border, rgba(6, 51, 61, 0.15));
    margin: var(--space-7) 0;
  }

  /* Footnotes: superscript reference markers in the body link down to a
     numbered list; each note links back up. */
  .prose :global(.fn-ref) {
    font-family: var(--font-mono);
    font-size: 0.7em;
    line-height: 0;
    vertical-align: super;
    margin-left: 1px;
  }
  .prose :global(.fn-ref a) {
    text-decoration: none;
    color: var(--color-accent-ink);
  }
  .prose :global(.post-footnotes) {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border, rgba(6, 51, 61, 0.15));
    font-size: var(--text-body-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }
  .prose :global(.post-footnotes-title) {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }
  .prose :global(.post-footnotes ol) {
    margin: 0;
    padding-left: 1.5em;
  }
  .prose :global(.post-footnotes li) {
    margin-bottom: var(--space-3);
    padding-left: 0.3em;
  }
  .prose :global(.post-footnotes li:target) {
    background: var(--color-surface-muted);
    border-radius: var(--radius);
    box-shadow: 0 0 0 var(--space-2) var(--color-surface-muted);
  }
  .prose :global(.fn-back) {
    font-family: var(--font-mono);
    text-decoration: none;
    margin-left: 0.4em;
    color: var(--color-accent-ink);
  }

  /* --- Long-form magazine layout ----------------------------------------
     From the first image on, each image becomes a sticky figure that pins to
     one side (alternating) while its accompanying text scrolls past. Built by
     the inline script above, which groups each image + following text into a
     .lf-scene. Falls back to a normal article if JS is off. */
  .lf-wide { max-width: 68rem; }
  /* Size container, so a banner image can break out to the full content width
     no matter which reading column it sits in. */
  .prose.longform { container-type: inline-size; }
  .prose.longform :global(.lf-intro) {
    max-width: var(--measure);
    margin: 0 auto;
  }
  /* A heading section with no pinned image is rendered full-width in the flow
     (a closing section, an aside, or a banner-image section). Text stays at the
     reading measure; a banner image inside breaks out (see .lf-banner). */
  .prose.longform :global(.lf-block) {
    align-self: center;
    width: 100%;
    max-width: var(--measure);
  }
  /* A banner image (one the editor opted out of the pinned side layout) breaks
     out of its reading column to span the full content width, in normal flow.
     100cqw is the content width; the negative-centre trick re-centres it from
     inside the narrower reading column. */
  .prose.longform :global(.lf-banner) {
    width: 100cqw;
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .prose.longform :global(.lf-banner img) { width: 100%; }
  /* The .lf-scenes flex gap already separates sections; without this the
     block's leading heading adds its own top margin on top of that gap, so a
     section-to-section break ends up doubly spaced. */
  .prose.longform :global(.lf-block > :first-child) { margin-top: 0; }
  /* The trailing coda (conclusion, footnotes) after the last `---`: back to a
     single full-width reading column. */
  .prose.longform :global(.lf-coda) {
    max-width: var(--measure);
    margin: var(--space-8) auto 0;
  }
  .prose.longform :global(.lf-scenes) {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    /* Section-to-section spacing. A flat value that matches the article's own
       H2 rhythm; the old clamp scaled with viewport height (8vh), which made the
       gap balloon on taller screens. */
    gap: var(--space-7);
  }
  .prose.longform :global(.lf-scene) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: var(--space-5);
    align-items: start;
  }
  /* Full-width lead: the section heading + intro span both columns, on top, so
     the pinned two-column layout begins at the first image. The heading runs
     the full width; the intro text stays at a readable measure beneath it. */
  .prose.longform :global(.lf-lead) {
    grid-column: 1 / -1;
    grid-row: 1;
    /* Sit in the same centred reading column as the intro and blocks so the
       heading lines up with the body text. */
    max-width: var(--measure);
    margin-inline: auto;
  }
  .prose.longform :global(.lf-lead > :first-child) { margin-top: 0; }
  .prose.longform :global(.lf-scene.media-left .lf-media) { grid-column: 1; grid-row: 2; }
