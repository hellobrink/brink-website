---
// Overview of our methods. Each method now has its own full page
// (offers/[slug].astro); this page introduces them and links out. Cards are
// ordered and numbered to match those pages.
import Layout from '../../layouts/Layout.astro';
import ExploreCTA from '../../components/ExploreCTA.astro';
import { withBase } from '../../lib/base';
import { getCollection } from 'astro:content';

const offers = await getCollection('offers');
const order = ['open-innovation', 'carve-outs', 'missions', 'futures'];
offers.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
---

<Layout
  title="Our methods"
  description="How Brink works: Open Innovation, Innovation Carve-Outs and Innovation Missions."
>
  <div class="container">
    <header class="page-header">
      <p class="mono kicker">Our methods</p>
      <h1 class="display">Ways we build funds and back innovation</h1>
      <p class="page-intro">
        Our work brings behavioural approaches to tried and trusted innovation
        methods. Each method addresses a different stage and type of systemic
        challenge.
      </p>
    </header>

    <ul class="method-grid">
      {offers.map((offer) => {
        const num = String(order.indexOf(offer.id) + 1).padStart(2, '0');
        return (
          <li>
            <a class:list={['method-card', `ground-${offer.data.ground}`]} href={withBase(`/methods/${offer.id}`)}>
              <span class="mc-num" aria-hidden="true">{num}</span>
              <h2 class="display mc-title">{offer.data.name}</h2>
              <p class="mc-summary">{offer.data.summary}</p>
              <span class="mono mc-more">Explore this method →</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>

  <ExploreCTA />
</Layout>

<style>
  .page-header {
    padding: var(--space-8) 0 var(--space-6);
    max-width: var(--measure);
  }
  .kicker {
    font-size: var(--text-tag);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent-ink);
    margin: 0 0 var(--space-3);
  }
  h1.display {
    font-size: var(--text-display);
    margin: 0 0 var(--space-4);
    line-height: var(--leading-tight);
  }
  .page-intro {
    font-size: var(--text-lead);
    max-width: var(--measure-narrow);
    margin: 0;
    color: var(--color-text-muted);
  }

  .method-grid {
    list-style: none;
    margin: 0 0 var(--space-9);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .ground-teal  { --mc-ink: var(--color-ground-1); }
  .ground-coral { --mc-ink: var(--color-ground-3); }
  .ground-blue  { --mc-ink: var(--color-ground-2); }
  .ground-pink  { --mc-ink: var(--color-ground-4); }
  /* Pink is light, so its card carries dark text. */
  .ground-pink.method-card { color: var(--color-text); }

  .method-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    background: var(--mc-ink);
    color: var(--color-text-inverted, #fff);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius);
    transition: transform 0.2s ease;
  }
  .method-card:hover { transform: translateY(-4px); }
  .mc-num {
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    opacity: 0.55;
    margin-bottom: var(--space-3);
  }
  .mc-title {
    font-size: var(--size-2xl);
    color: inherit;
    margin: 0 0 var(--space-3);
    line-height: var(--leading-tight);
  }
  .mc-summary {
    margin: 0 0 var(--space-5);
    opacity: 0.95;
    line-height: var(--leading-snug, 1.35);
  }
  .mc-more {
    margin-top: auto;
    font-size: var(--text-tag);
    opacity: 0.85;
  }
  .method-card:hover .mc-more { opacity: 1; }
</style>
